# Standalone Solar System build.
#
# IS_PRO is true because the Solar System Pack (the outer moons, the big four asteroids
# and the procedural belt) lives in the plugins-pro submodule - an OSS build of this
# profile would come up with the planets, Mars' moons and the dwarf planets only, which
# is not the product. See docs-local/oss-pro-split-solar-system.md.
MODE=development
IS_PRO=true
EDITION=solar-system
